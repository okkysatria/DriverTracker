<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@drawable/bg_notification_tracking"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="6dp">

    <ImageView
        android:id="@+id/notif_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="@null"
        android:src="@mipmap/ic_launcher_round" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notif_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Driver Tracker"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Status tracking"
            android:textColor="#C5D0D9"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btn_action_2"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/bg_notification_action_secondary"
        android:gravity="center"
        android:minWidth="48dp"
        android:paddingHorizontal="7dp"
        android:text="BATAL"
        android:textColor="#FFB4AB"
        android:textSize="8sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btn_action_1"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginStart="5dp"
        android:background="@drawable/bg_notification_action_primary"
        android:gravity="center"
        android:minWidth="58dp"
        android:paddingHorizontal="7dp"
        android:text="MULAI"
        android:textColor="#FFFFFF"
        android:textSize="8sp"
        android:textStyle="bold" />
</LinearLayout>
